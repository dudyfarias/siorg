{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npx vite build",
  "outputDirectory": "dist/client",
  "rewrites": [
    { "source": "/novas-estruturas", "destination": "/index.html" },
    { "source": "/novas-estruturas/", "destination": "/index.html" }
  ]
}
