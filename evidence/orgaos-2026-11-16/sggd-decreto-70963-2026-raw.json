{"id":"bea4ccc8-33ff-40f6-44c4-08df2e3dc023","journalId":"ca96256b-6ca1-407f-866e-567ef9430123","sectionId":"81f77c5c-d935-49ac-7d52-08db6b94d2bf","firstLevelSectionId":"257b103f-1eb2-4f24-a170-4e553c7e4aac","secondLevelSectionId":"81f77c5c-d935-49ac-7d52-08db6b94d2bf","title":"DECRETO Nº 70.963, DE 6 DE NOVEMBRO DE 2026","slug":"executivo/decretos/decreto-n-70963-de-6-de-novembro-de-2026-202611061182022264926","date":"2026-11-09","journal":"Executivo","section":"Decretos","firstLevelSectionName":"Atos Normativos","secondLevelSectionName":"Decretos","publicationType":"Decreto Numerado","editionPages":[],"content":"<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01//EN\" \"http://www.w3.org/TR/html4/strict.dtd\">\n<html lang=\"pt-br\" style=\"background-color: transparent !important; ; background-color: transparent !important;\">\n<head style=\"background-color: transparent !important; ; background-color: transparent !important;\">\n<meta http-equiv=\"Pragma\" content=\"no-cache\" style=\"background-color: transparent !important; ; background-color: transparent !important;\">\n<meta name=\"robots\" content=\"noindex\" style=\"background-color: transparent !important; ; background-color: transparent !important;\">\n<meta http-equiv=\"Content-Type\" content=\"text/html; charset=iso-8859-1\" style=\"background-color: transparent !important; ; background-color: transparent !important;\">\n<title style=\"background-color: transparent !important; ; background-color: transparent !important;\">SEI/GESP - 0125328173 - DOE: Decreto numerado</title>\n<style type=\"text/css\" style=\"background-color: transparent !important; ; background-color: transparent !important;\">p.Citacao {font-size:10pt; font-family:Calibri; word-wrap:normal; margin:4pt 0 4pt 160px; text-align:justify; } p.DOE_Alinhado_Direita {font-size:16pt; font-family:Open Sans; text-align:right; word-wrap:normal; margin:6pt; } p.DOE_Alinhado_Esquerda {font-size:16pt; font-family:Open Sans; text-align:left; word-wrap:nor