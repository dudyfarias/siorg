  "content": "<!DOCTYPE html PUBLIC \"-//W3C//DTD HTML 4.01//EN\" \"http://www.w3.org/TR/html4/strict.dtd\">\n<html lang=\"pt-br\" style=\"background-color: transparent !important; ; background-color: transparent !important;\">\n<head style=\"background-color: transparent !important; ; background-color: transparent !important;\">\n<meta http-equiv=\"Pragma\" content=\"no-cache\" style=\"background-color: transparent !important; ; background-color: transparent !important;\">\n<meta name=\"robots\" content=\"noindex\" style=\"background-color: transparent !important; ; background-color: transparent !important;\">\n<meta http-equiv=\"Content-Type\" content=\"text/html; charset=iso-8859-1\" style=\"background-color: transparent !important; ; background-color: transparent !important;\">\n<title style=\"background-color: transparent !important; ; background-color: transparent !important;\">SEI/GESP - 0125586769 - DOE: Portaria (Seção 1 - Normativo)</title>\n<style type=\"text/css\" style=\"background-color: transparent !important; ; background-color: transparent !important;\">p.Citacao {font-size:10pt; font-family:Calibri; word-wrap:normal; margin:4pt 0 4pt 160px; text-align:justify; } p.DOE_Alinhado_Direita {font-size:16pt; font-family:Open Sans; text-align:right; word-wrap:normal; margin:6pt; } p.DOE_Alinhado_Esquerda {font-size:16pt; font-family:Open Sans; text-align:left; word-wrap:normal; margin:margin; } p.DOE_Centralizado {font-size:16pt; font-family:Open Sans; text-align:center; word-wrap:normal; margin:6pt; } p.DOE_Ementa {font-size:16pt; font-family:Open Sans; text-indent: 34.448567708333336%; text-align:justify; word-wrap:normal; margin:6pt; } p.DOE_Justificado {font-size:16pt; font-family:Open Sans; text-align:justify; word-wrap:normal; text-indent:0; margin:6pt; } p.DOE_Justificado_Recuo_Primeira_Linha {font-size:16pt; font-family:Open Sans; text-indent: 12.303059895833334%; text-align:justify; word-wrap:normal; margin:6pt; } p.Decreto_Data_Courier {font-size